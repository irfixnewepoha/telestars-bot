# ============================================================
# ПРОСТЫЕ НАСТРОЙКИ — что заполнить на Railway
# ============================================================

# --- 1. TELEGRAM (обязательно) ---
# @BotFather → /newbot → скопировать токен
BOT_TOKEN=

# Ваш числовой id: напишите @userinfobot
ADMIN_IDS=

# Название магазина в приветствии
BRAND_NAME=MyStars

USE_POLLING=true
ENVIRONMENT=production

# Цена 1 звезды для покупателя
STAR_PRICE_RUB=1.5
STAR_PRICE_TON=0.013
MIN_STARS=50
MAX_STARS=9999


# --- 2. ОПЛАТА TON через CryptoBot (рекомендуется для старта) ---
# Откройте @CryptoBot → Crypto Pay → Create App → API Token
CRYPTOBOT_TOKEN=
CRYPTOBOT_TESTNET=false
CRYPTOBOT_ASSET=TON


# --- 3. ОПЛАТА СБП через Platega (по желанию) ---
# Сайт https://app.platega.io → регистрация → Настройки
# MerchantId и Secret (X-Secret)
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=
PLATEGA_WEBHOOK_PATH=/webhooks/platega/my-secret
PLATEGA_RETURN_URL=https://t.me/


# --- 4. АВТОВЫДАЧА STARS (главное для автоматизации) ---
# 24 слова от TON-кошелька, на котором лежит TON для покупки Stars.
# Этот кошелёк должен быть тем, с которого вы покупаете на Fragment
# (лучше V4R2; один раз вручную купите 50 Stars на fragment.com с него).
#
# ВАЖНО: это НЕ «Fragment API key» — это сид ВАШЕГО кошелька.
# Пополняйте этот кошелёк TON — бот сам покупает Stars покупателям.
TON_MNEMONIC=word1 word2 word3 ... word24
TON_WALLET_VERSION=v4r2

# Прокси API для покупки Stars (по умолчанию уже правильный)
FRAGMENT_API_BASE=https://api.fragment-api.space

# Опционально: cookies Fragment (если нужен KYC-режим, 0% комиссии API)
# Cookie-Editor на fragment.com → Header string
FRAGMENT_COOKIES=


# --- 5. БАЗА (Railway плагины) ---
# После Add PostgreSQL скопируйте URL и замените postgres:// на postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/railway

# После Add Redis — вставьте URL
REDIS_URL=redis://default:pass@host:6379


# --- 6. ПРОЧЕЕ ---
SUPPORT_URL=https://t.me/your_support
FAQ_TEXT=Оплата TON или СБП. Stars приходят автоматически после оплаты.
LOG_LEVEL=INFO
